class Solution {
    public int numOfSubarrays(int[] arr, int k, int threshold) {
        int n = arr.length;
        int count = 0;
        int sum = 0;

        // First window
        for (int i = 0; i < k; i++) {
            sum += arr[i];
        }

        // Check first window
        if (sum >= k * threshold) {
            count++;
        }

        // Slide the window
        for (int i = k; i < n; i++) {
            sum += arr[i];       // add new element
            sum -= arr[i - k];   // remove old element

            if (sum >= k * threshold) {
                count++;
            }
        }

        return count;
    }
}
